# Copy this file to `.env` for local development, then supply a unique value.
# `.env` is ignored by Git and must never be committed.
# Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Use `production` only on a HTTPS deployment. Production will refuse to start
# without SECRET_KEY and will mark session cookies Secure.
APP_ENV=development

# Keep disabled outside local debugging.
FLASK_DEBUG=0
